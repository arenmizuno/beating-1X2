# Virtual environments
.venv/
env/
venv/

# Python
__pycache__/
*.pyc
*.egg-info/
.ipynb_checkpoints/

# OS
.DS_Store

# Data is regenerated by the ingestion stages, never committed.
# See README for how to rebuild data/ from scratch.
/data/raw/
/data/interim/
/data/processed/

# NOTE: data/mappings/ IS committed. The team alias table is hand-curated and
# is a source input, not a derived artifact.
!/data/mappings/

# MLflow local tracking store
mlruns/
mlartifacts/

# Evidently HTML reports embed their entire JS runtime -- 5.6 MB each, 34 MB for
# the set, against 32 KB for the drift metrics that actually matter. The CSV and
# JSON outputs beside them ARE committed; regenerate the HTML with
# `python -m src.drift`.
reports/drift/*.html

# LightGBM / misc run artifacts
*.log
lightgbm_model.txt
